    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fflate": "^0.8.2",
    "jsdom": "^30.0.1",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  }
